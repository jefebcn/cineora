# Copia SOLO in apps/api/.env. Il frontend usa apps/web/.env.example (nessun segreto nel web).
DATABASE_URL="postgresql://cineora:cineora_dev_password@127.0.0.1:5432/cineora?schema=public"
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
TMDB_READ_ACCESS_TOKEN=YOUR_TMDB_V4_READ_ACCESS_TOKEN
API_PORT=4000
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
ADMIN_SYNC_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
ENABLE_SCHEDULER=1

# Numero di pagine TMDB per tipo per ciclo discover (1..10)
TMDB_DISCOVER_PAGES=5
# Numero titoli esistenti da aggiornare giornalmente (1..200)
TMDB_REFRESH_BATCH=100

# Solo novita' cinema/TV TMDB (non e' il feed ultime aggiunte di un sito terzo).
TMDB_NEW_RELEASE_PAGES=3
# File locale creato da match-reference-tmdb.mjs; si puo' omettere finche' non esiste.
CINEORA_SOURCE_FEED=../../data/source-latest-enriched.json
